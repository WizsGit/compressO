generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int      @id @default(autoincrement())
  telegramId       BigInt   @unique
  fullName         String?
  nickname         String?
  registrationDate DateTime @default(now())
  usageCount       Int      @default(0)
  lastUsageDate    DateTime @default(now())
}
